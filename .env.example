# Example configuration; copy to .env.local and adjust. No secrets belong here.
# Only invented local values. Real values are never committed (.env is ignored).

# Base URL of the institution server that /api/v1 requests are sent to.
# When unset, the default in src/server/institution-server.js is used.
INSTITUTION_SERVER_URL=http://127.0.0.1:4000

# Disable Next.js anonymous telemetry (as in CI).
NEXT_TELEMETRY_DISABLED=1

# Only for the e2e tests (tests/e2e); the Playwright config sets these itself.
# LAZNI_PORT=4199
# APP_PORT=5177
# PROXY_PORT=5178
